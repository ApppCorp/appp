{
	"name": "appp",
	"version": "2.0.0",
	"private": true,
	"description": "APPP - Australia Premium Products Platform, B2B product sourcing and export",
	"type": "module",
	"scripts": {
		"build": "next build",
		"cf:build": "opennextjs-cloudflare build",
		"cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf:type": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"check": "tsc --noEmit",
		"dev": "next dev",
		"images": "node script/build-images.mjs",
		"purge": "rimraf .next .open-next .wrangler node_modules package-lock.json",
		"start": "next start"
	},
	"dependencies": {
		"daisyui": "5.8.1",
		"lucide-react": "1.75.0",
		"motion": "14.14.0",
		"next": "16.4.6",
		"next-intl": "4.15.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"sharp": "0.35.5"
	},
	"devDependencies": {
		"@opennextjs/cloudflare": "1.20.17",
		"@tailwindcss/postcss": "4.3.5",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"rimraf": "6.1.4",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"wrangler": "4.164.0"
	},
	"allowScripts": {
		"@swc/core@1.16.22": true,
		"workerd@1.20261117.1": true,
		"esbuild@0.28.2": true,
		"@parcel/watcher@2.6.0": true,
		"fsevents@2.3.3": true
	}
}
